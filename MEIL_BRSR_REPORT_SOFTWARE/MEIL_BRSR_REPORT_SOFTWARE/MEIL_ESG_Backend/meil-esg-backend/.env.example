# Copy to .env and fill in real values. Never commit the real .env file.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-a-different-long-random-string

# --- Database ---
# Leave unset to use the local SQLite file at instance/meil_esg.db (zero setup, good for a demo).
# For docker-compose / production, point at MySQL:
# DATABASE_URL=mysql+pymysql://esg_user:change_me@localhost:3306/meil_esg
DATABASE_URL=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# true = tasks run synchronously in-request, no worker process needed (good for a demo/hackathon)
# false = tasks are enqueued and need `celery -A app.celery_app.celery_app worker` running
CELERY_TASK_ALWAYS_EAGER=true

# --- Object storage ---
# "local" writes evidence/report files under instance/uploads (zero setup).
# "minio" requires the MinIO service (see docker/docker-compose.yml) and the keys below.
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=meil-esg
MINIO_SECURE=false

# --- CORS (the Vite dev server origin) ---
CORS_ORIGINS=http://localhost:5173

# --- AI provider ---
# "rule_based" needs no key and matches the frontend's existing BRSR Copilot behaviour exactly.
# Set "gemini" or "openai" and the matching key below to switch providers with no code change.
AI_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Password hashing ---
PASSWORD_HASHER=argon2

MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
